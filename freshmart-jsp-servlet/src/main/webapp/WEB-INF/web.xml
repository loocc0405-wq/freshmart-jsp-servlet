<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>FreshMart</display-name>

    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <!-- UTF-8 for Vietnamese -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.freshmart.web.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authn (login required) -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.freshmart.web.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/staff/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/pro/*</url-pattern>
    </filter-mapping>

    <!-- Authorization -->
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.freshmart.web.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/staff/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/pro/*</url-pattern>
    </filter-mapping>

    <!-- Tier gating: PRO module -->
    <filter>
        <filter-name>TierFilter</filter-name>
        <filter-class>com.freshmart.web.filter.TierFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>TierFilter</filter-name>
        <url-pattern>/pro/*</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
