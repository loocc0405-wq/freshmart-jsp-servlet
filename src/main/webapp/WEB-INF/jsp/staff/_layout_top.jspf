<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="path" value="${pageContext.request.servletPath}" />

<c:set var="suppliersActive" value="${fn:startsWith(path, '/staff/suppliers')}" />
<c:set var="productsActive" value="${fn:startsWith(path, '/staff/products')}" />
<c:set var="ordersActive" value="${fn:startsWith(path, '/staff/orders')}" />
<c:set var="inventoryActive"
       value="${fn:startsWith(path, '/staff/inventory')
               or fn:startsWith(path, '/staff/import-lot')
               or fn:startsWith(path, '/staff/inventory-report')}" />

<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" /> | FreshMart Staff</title>

    <!-- Core Assets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;800&display=swap" rel="stylesheet"/>

    <!-- Design System -->
    <link rel="stylesheet" href="${ctx}/assets/css/fm-design-system.css?v=2"/>
    <link rel="stylesheet" href="${ctx}/assets/css/fm-components.css?v=2"/>
    
    <style>
        body { background-color: var(--fm-slate-50); }
        .sidebar { background: #fff; width: 260px; height: 100vh; position: fixed; left: 0; top: 0; border-right: 1px solid var(--fm-border-color); z-index: 1000; }
        .sidebar-brand { height: 64px; display: flex; align-items: center; padding: 0 1.5rem; font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--fm-primary-600); font-size: 1.25rem; border-bottom: 1px solid var(--fm-border-color); }
        .sidebar-nav { padding: 1rem 0; }
        .sidebar-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: var(--fm-slate-600); text-decoration: none; font-weight: 600; font-size: 0.875rem; transition: all 0.2s; border-left: 3px solid transparent; }
        .sidebar-link:hover { color: var(--fm-primary-600); background: var(--fm-primary-50); }
        .sidebar-link.active { color: var(--fm-primary-700); background: var(--fm-primary-50); border-left-color: var(--fm-primary-600); }
        .sidebar-link i { font-size: 1.15rem; margin-right: 0.75rem; width: 24px; text-align: center; }
        .sidebar-heading { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fm-slate-400); padding: 1.5rem 1.5rem 0.5rem; }
    </style>
</head>

<body class="fm-app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-leaf-fill me-2 text-success"></i>FreshMart Staff
        </div>
        <div class="sidebar-nav">
            <div class="sidebar-heading">Analytics</div>
            <a href="${ctx}/staff" class="sidebar-link ${path == '/staff' ? 'active' : ''}">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            
            <div class="sidebar-heading">Inventory</div>
            <a href="${ctx}/staff/inventory" class="sidebar-link ${fn:startsWith(path, '/staff/inventory') and not fn:startsWith(path, '/staff/inventory-report') ? 'active' : ''}">
                <i class="bi bi-box-seam"></i> Overviews / FEFO
            </a>
            <a href="${ctx}/staff/import-lot" class="sidebar-link ${fn:startsWith(path, '/staff/import-lot') ? 'active' : ''}">
                <i class="bi bi-truck"></i> New Import
            </a>
            <a href="${ctx}/staff/inventory-report" class="sidebar-link ${fn:startsWith(path, '/staff/inventory-report') ? 'active' : ''}">
                <i class="bi bi-file-earmark-bar-graph"></i> Data Reporting
            </a>

            <div class="sidebar-heading">Resources</div>
            <a href="${ctx}/staff/products" class="sidebar-link ${productsActive ? 'active' : ''}">
                <i class="bi bi-tag"></i> Products
            </a>
            <a href="${ctx}/staff/suppliers" class="sidebar-link ${suppliersActive ? 'active' : ''}">
                <i class="bi bi-building"></i> Suppliers
            </a>

            <div class="sidebar-heading">Commerce & Sales</div>
            <a href="${ctx}/staff/orders" class="sidebar-link ${ordersActive ? 'active' : ''}">
                <i class="bi bi-cart-check"></i> OMS Orders
            </a>
            <a href="${ctx}/seller/pos" class="sidebar-link ${fn:startsWith(path, '/seller/pos') ? 'active' : ''}">
                <i class="bi bi-shop"></i> Smart POS
            </a>

            <div class="sidebar-heading">Advanced (Pro)</div>
            <a href="${ctx}/pro/replenishment" class="sidebar-link ${fn:startsWith(path, '/pro/replenishment') ? 'active' : ''}">
                <i class="bi bi-arrow-repeat"></i> Auto-Replenish
            </a>
            <a href="${ctx}/pro/seasonality" class="sidebar-link ${fn:startsWith(path, '/pro/seasonality') ? 'active' : ''}">
                <i class="bi bi-calendar-range"></i> Seasonality
            </a>
        </div>
    </aside>

    <div class="fm-app-main">
        <header class="fm-topbar sticky-top px-4">
            <div class="d-flex w-100 align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light d-lg-none" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="text-muted d-none d-md-block fs-7">
                        <i class="bi bi-house-door-fill me-1"></i> Staff /
                        <span class="text-dark fw-bold px-1">${pageTitle}</span>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block">
                        <div class="fw-bold text-dark fs-7 lh-1 mb-1">
                            <c:out value="${empty sessionScope.authUser.fullName ? sessionScope.authUser.username : sessionScope.authUser.fullName}" />
                        </div>
                        <div class="text-muted fs-8 text-uppercase fw-bold ls-wide"><c:out value="${sessionScope.authUser.role}" /></div>
                    </div>
                    <div class="vr mx-2 opacity-10" style="height: 24px;"></div>
                    <a href="${ctx}/logout" class="fm-btn btn-light border btn-sm text-danger fw-bold">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </a>
                </div>
            </div>
        </header>

        <main class="fm-page">
            <c:if test="${not empty sessionScope.flash}">
                <div class="alert alert-success alert-dismissible fade show fm-surface shadow-sm border-0 border-start border-success border-4 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                        <div><c:out value="${sessionScope.flash}"/></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <c:remove var="flash" scope="session"/>
            </c:if>